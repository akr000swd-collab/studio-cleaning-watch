# ── Google サービスアカウント ──
# GCPでCalendar APIを有効化し、サービスアカウントを作成してJSONキーを発行してください。
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# JSONキー内の private_key をそのまま貼り付けてください(改行は \n のままでOK)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# ── 監視対象スタジオ(予約カレンダー) ──
# name: 清掃カレンダーの予定タイトルに含まれるスタジオ名と一致させてください
# reservationCalendarId: 各スタジオの予約用GoogleカレンダーID(カレンダー設定 > カレンダーの統合 に記載)
STUDIOS_CONFIG=[{"name":"Aスタジオ","reservationCalendarId":"studio-a@group.calendar.google.com"},{"name":"Bスタジオ","reservationCalendarId":"studio-b@group.calendar.google.com"}]

# ── 清掃担当者のカレンダー ──
# staff: 表示用の担当者名
# calendarId: その担当者の清掃用GoogleカレンダーID
CLEANING_CALENDARS_CONFIG=[{"staff":"Aさん","calendarId":"staff-a@example.com"},{"staff":"Bさん","calendarId":"staff-b@example.com"}]

# ── 警報のしきい値 ──
# 次の予約開始までこの分数を切っても清掃予定がない場合に、音を鳴らす警報にする
ALERT_THRESHOLD_MINUTES=60

# 予約を確認する時間の範囲(現在時刻の前後何時間分を見るか)
WINDOW_HOURS_BEFORE=48
WINDOW_HOURS_AFTER=48

# 清掃予定が前の利用終了よりこの分数だけ早く始まっていても「対応済み」とみなす
COVERAGE_BUFFER_MINUTES=15

# ── 期間を指定して監視する場合(画面の「監視期間」で from/to を指定したとき) ──
# 指定した期間の最初の利用より前、最後の利用より後の清掃予定を、それぞれ何日分遡り/先読みして探すか
RANGE_LOOKBACK_DAYS=7
RANGE_LOOKAHEAD_DAYS=7

# ── ダッシュボードのパスワード保護(任意) ──
# 設定すると、ダッシュボードを開く際にパスワード入力が必要になります。未設定なら保護なし。
APP_PASSWORD=

# ── フロント側のポーリング間隔(ミリ秒) ──
NEXT_PUBLIC_POLL_INTERVAL_MS=30000
